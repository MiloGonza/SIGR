# Copia este archivo como .env. Valores listos para trabajar SIN dominio.

DEBUG=True
# Genera uno con: cd Back && .venv/bin/python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=pega-aqui-la-clave-que-genere-el-comando-anterior
# Con localhost/127.0.0.1 basta mientras trabajes en tu máquina.
# Si entras desde otro equipo con la IP del servidor, AGREGA esa IP o dará 400.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL: estos valores deben coincidir con un usuario/base de datos que ya existan en tu Postgres.
# DB_NAME = nombre de la base de datos que creaste (ej. sigr_db)
# DB_USER = usuario de Postgres (ej. postgres o sigr_user)
# DB_PASSWORD = la contraseña que le pusiste a ese usuario
# DB_HOST = 127.0.0.1 si Postgres está en la misma máquina; el nombre del servicio si está en Docker
# DB_PORT = 5432 (puerto estándar de Postgres)
DB_NAME=sigr_db
DB_USER=postgres
DB_PASSWORD=la-contraseña-de-tu-usuario-de-postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# URL del frontend que hace las peticiones (Vite en desarrollo).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

# Déjalos en False/0 hasta que tengas HTTPS real.
TRUST_PROXY_SSL_HEADER=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

DEFAULT_FROM_EMAIL=no-reply@sigr.local

# ---------------------------------------------------------------------------
# CUANDO DESPLEGUES A UN SERVIDOR SIN DOMINIO (solo IP):
# DEBUG=False
# ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50   <- la IP real de tu servidor
# CORS_ALLOWED_ORIGINS=http://192.168.1.50:5173   <- IP donde corra el front
# CSRF_TRUSTED_ORIGINS=http://192.168.1.50:8000
# SECURE_* se quedan en False/0 porque todavía no hay HTTPS.
# ---------------------------------------------------------------------------
