# VITE_API_URL es la URL donde el front llama al backend.
# Se substituye en el momento de compilar (npm run build), no en tiempo de ejecución.

# 1) Desarrollo local: NO hace falta crear .env.production; el código ya usa
#    http://127.0.0.1:8000 por defecto. Puedes dejar este archivo solo como referencia.
VITE_API_URL=http://127.0.0.1:8000

# 2) Cuando despliegues SIN dominio, copia este archivo como .env.production
#    y cambia la IP por la de tu servidor antes de compilar:
# VITE_API_URL=http://192.168.1.50:8000
