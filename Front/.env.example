# Plantilla del frontend. Copia este archivo como .env.production antes de compilar.
# En desarrollo local NO hace falta crearlo: el código ya usa http://127.0.0.1:8000.

# URL del backend al que el frontend llama. Se graba dentro del bundle al ejecutar
# "pnpm build"; cambiar este archivo después exige volver a compilar.
VITE_API_URL=http://127.0.0.1:8000

# Cuando despliegues sin dominio, sustituye la IP por la de tu servidor:
# VITE_API_URL=http://192.168.1.50:8000
